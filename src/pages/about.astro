---
import Base from '../layouts/Base.astro';
import { SITE } from '../site';

---

<Base title="About">
  <div class="wrap about">
    <h1>Hi, I'm {SITE.author}.</h1>

    <div class="prose">
      <p>
        I'm an engineer who likes to understand how things work — and, more and more, how I work. This journal is
        where both of those meet: notes on what I'm building and learning, and honest writing about what I'm
        thinking and feeling along the way.
      </p>
      <p>
        Nothing here is meant to be definitive. Think of every entry as a snapshot of a mind in progress.
      </p>
    </div>

    <div class="contact">
      {SITE.links.email && <a class="box-link" href={SITE.links.email}>Email</a>}
      <a class="box-link" href="https://viverun.github.io/">Portfolio ↗</a>
      <a class="box-link" href={SITE.links.github}>GitHub ↗</a>
    </div>
  </div>
</Base>

<style>
  .about {
    padding-top: clamp(2.5rem, 7vw, 5rem);
  }

  h1 {
    margin: 1.5rem 0 2.5rem;
    font-size: var(--t-display);
    font-weight: 800;
    line-height: 1;
    letter-spacing: -0.045em;
    text-transform: uppercase;
  }




  .contact {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-top: 3rem;
  }
</style>
