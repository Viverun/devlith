---
import Base from '../../layouts/Base.astro';
import ModelMark from '../../components/ModelMark.astro';
import { url } from '../../lib/url';
import { MODELS } from '../../lib/models';
import { getTests } from '../../lib/tests';

const tests = await getTests();
const count = (id: string) => tests.filter((t) => t.model === id).length;
const models = [...MODELS].sort((a, b) => count(b.id) - count(a.id));
---

<Base
  title="Model Testing"
  description="Hands-on tests of AI models: what they get right, where they break, and what their reasoning looks like from the inside."
  image="/og/model-testing.png"
>
  <div class="wrap">
    <header class="head">
      <span class="label label--ink">Viverun / Lab</span>
      <h1 data-stream="char">Model Testing</h1>
      <p class="intro">
        I put AI models through problems I can check, on hardware I actually own, and write down what happens:
        the answers, the mistakes, and the reasoning they mumble to themselves along the way.
      </p>
    </header>

    <div class="section-head">
      <span class="label label--ink">01 / Models</span>
      <span class="label">{tests.length} write-up{tests.length === 1 ? '' : 's'}</span>
    </div>

    <ol class="models">
      {
        models.map((m) => (
          <li>
            <a class="model" href={url(`/model-testing/${m.id}`)}>
              <ModelMark model={m} />
              <div class="body">
                <h2>{m.name}</h2>
                <span class="label">{m.maker}</span>
                <p>{m.blurb}</p>
              </div>
              <span class="label n">{count(m.id) ? `${count(m.id)} test${count(m.id) === 1 ? '' : 's'} →` : 'Soon'}</span>
            </a>
          </li>
        ))
      }
    </ol>
  </div>
</Base>

<style>
  .head {
    padding-top: clamp(2.5rem, 7vw, 5rem);
    margin-bottom: clamp(2.5rem, 6vw, 4rem);
  }

  h1 {
    margin: 1.5rem 0 1.75rem;
    font-size: var(--t-display);
    font-weight: 800;
    line-height: 0.98;
    letter-spacing: -0.045em;
    text-transform: uppercase;
  }

  .intro {
    max-width: 60ch;
    margin: 0;
    font-size: 1.125rem;
    line-height: 1.6;
    color: var(--muted);
  }

  .models {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .models li {
    border-bottom: 1px solid var(--rule);
  }

  .model {
    display: grid;
    grid-template-columns: auto 1fr auto;
    align-items: center;
    gap: clamp(1.25rem, 3vw, 2.25rem);
    padding-block: clamp(1.5rem, 3.5vw, 2.25rem);
    text-decoration: none;
    transition: background 0.2s, padding 0.2s;
  }

  .model:hover {
    background: var(--paper-deep);
    padding-inline: 1rem;
  }

  .body h2 {
    margin: 0 0 0.2rem;
    font-size: var(--t-h2);
    font-weight: 800;
    line-height: 1.08;
    letter-spacing: -0.03em;
    text-transform: uppercase;
  }

  .body p {
    margin: 0.6rem 0 0;
    max-width: 56ch;
    font-size: 0.875rem;
    color: var(--muted);
  }

  .n {
    color: var(--ink);
    font-weight: 600;
  }

  @media (max-width: 560px) {
    .model {
      grid-template-columns: auto 1fr;
    }
    .n {
      grid-column: 2;
    }
  }
</style>
