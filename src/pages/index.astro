---
import Base from '../layouts/Base.astro';
import { url } from '../lib/url';
import { SITE } from '../site';
import { getPosts, fmtDate } from '../lib/posts';

const posts = await getPosts();
const latest = posts.slice(0, 5);
---

<Base>
  <section class="hero wrap">
    <h1 class="headline" data-stream="char">
      {
        SITE.hero.map((line, i) => (
          <span class="line">
            {line}
            {i === SITE.hero.length - 1 && <span class="cursor" aria-hidden="true" />}
          </span>
        ))
      }
    </h1>

    <a class="scroll-cue" href="#latest" aria-label="Scroll to the latest entries">
      <span class="label">Scroll</span>
      <svg viewBox="0 0 16 24" aria-hidden="true"><path d="M8 2v18M2 14l6 6 6-6" /></svg>
    </a>
  </section>

  <section id="latest" class="wrap latest">
    <div class="section-head">
      <span class="label label--ink">01 / Latest entries</span>
      <a class="arrow-link" href={url('/writing')}>All {posts.length} →</a>
    </div>

    <ol class="entries">
      {
        latest.map((post) => (
          <li>
            <a class="entry" href={url(`/writing/${post.id}`)}>
              <span class="no">{post.no}</span>
              <div class="body">
                <h2>{post.data.title}</h2>
                <p>{post.data.description}</p>
              </div>
              <div class="meta label">
                <span>{post.data.topic}</span>
                <span>{fmtDate(post.data.date)}</span>
                <span>{post.minutes} min</span>
              </div>
            </a>
          </li>
        ))
      }
    </ol>
  </section>

  <section class="wrap colophon">
    <div class="section-head">
      <span class="label label--ink">02 / Why this exists</span>
    </div>
    <p>
      This is where I think out loud — about engineering, about learning, and about whatever I happen to be
      feeling at the time. No algorithm, no engagement metrics. Just a notebook that happens to be public.
    </p>
    <a class="box-link" href={url('/about')}>More about me</a>
  </section>
</Base>

<style>
  /* ---------- hero ---------- */
  .hero {
    position: relative;
    /* fill exactly what's left under the header (its height is measured in Base.astro) */
    min-height: calc(100svh - var(--header-h, 4rem));
    display: grid;
    place-content: center;
    justify-items: center;
    gap: clamp(2.5rem, 6vw, 4.5rem);
    padding-block: 5rem;
  }

  .headline {
    margin: 0;
    display: grid;
    justify-items: center;
    font-size: var(--t-hero);
    font-weight: 800;
    line-height: 0.95;
    letter-spacing: -0.045em;
    text-align: center;
  }

  /* ---------- scroll cue ---------- */
  .scroll-cue {
    position: absolute;
    bottom: clamp(1.25rem, 4vh, 2.5rem);
    left: 50%;
    translate: -50% 0;
    display: grid;
    justify-items: center;
    gap: 0.4rem;
    text-decoration: none;
  }

  .scroll-cue svg {
    width: 0.9rem;
    height: 1.35rem;
    fill: none;
    stroke: var(--ink);
    stroke-width: 1.5;
    stroke-linecap: square;
    animation: nudge 1.8s ease-in-out infinite;
  }

  .scroll-cue:hover .label {
    color: var(--ink);
  }

  @keyframes nudge {
    0%, 100% { transform: translateY(0); opacity: 0.55; }
    50% { transform: translateY(6px); opacity: 1; }
  }

  @media (prefers-reduced-motion: reduce) {
    .scroll-cue svg {
      animation: none;
    }
  }

  /* ---------- latest ---------- */
  .entries {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .entries li {
    border-bottom: 1px solid var(--rule);
  }

  .entry {
    display: grid;
    grid-template-columns: 5rem 1fr 11rem;
    gap: 1.5rem;
    padding-block: clamp(1.75rem, 4vw, 2.75rem);
    text-decoration: none;
    transition: background 0.2s, padding 0.2s;
  }

  .entry:hover {
    background: var(--paper-deep);
    padding-inline: 1rem;
  }

  .no {
    font-size: var(--t-small);
    font-weight: 500;
    color: var(--muted);
  }

  .body h2 {
    margin: 0 0 0.6rem;
    font-size: var(--t-h2);
    font-weight: 800;
    line-height: 1.08;
    letter-spacing: -0.03em;
    text-transform: uppercase;
  }

  .body p {
    margin: 0;
    max-width: 52ch;
    font-size: 0.875rem;
    color: var(--muted);
  }

  .meta {
    display: grid;
    align-content: start;
    justify-items: end;
    gap: 0.2rem;
  }

  @media (max-width: 720px) {
    .entry {
      grid-template-columns: 1fr;
      gap: 0.75rem;
    }
    .meta {
      grid-auto-flow: column;
      justify-content: start;
      gap: 1rem;
    }
  }

  /* ---------- colophon ---------- */
  .colophon {
    margin-top: clamp(4rem, 9vw, 7rem);
  }

  .colophon p {
    max-width: 60ch;
    margin: 2rem 0;
    font-size: 1.125rem;
    line-height: 1.6;
  }
</style>
