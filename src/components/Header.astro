---
import { SITE } from '../site';
import { url, unbase } from '../lib/url';

const nav = [
  { href: '/', label: 'Index' },
  { href: '/writing', label: 'Writing' },
  { href: '/about', label: 'About' },
];
const path = unbase(Astro.url.pathname).replace(/\/$/, '') || '/';
const isActive = (href: string) => (href === '/' ? path === '/' : path.startsWith(href));
---

<header class="site-header wrap">
  <a class="brand" href={url('/')}>
    <svg class="mark" viewBox="10 12 44 40" aria-hidden="true">
      <path d="M12 14h9.5L27 40l5.5-26H42L32 50H22z" />
      <rect class="cursor-bar" x="48" y="12" width="4" height="40" />
    </svg>
    {SITE.name}
  </a>
  <nav aria-label="Primary">
    {
      nav.map((item) => (
        <a href={url(item.href)} aria-current={isActive(item.href) ? 'page' : undefined}>
          {item.label}
        </a>
      ))
    }
  </nav>
  <span></span>
</header>

<style>
  .site-header {
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    gap: 1rem;
    padding-block: 1.1rem;
  }

  .brand {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    justify-self: start;
    font-size: var(--t-small);
    font-weight: 800;
    letter-spacing: 0.04em;
    text-decoration: none;
  }

  .mark {
    width: 1.35rem;
    height: auto;
    fill: currentColor;
  }

  .brand:hover .cursor-bar {
    animation: blink 1.1s steps(1) infinite;
  }

  nav {
    display: flex;
    gap: clamp(1rem, 3vw, 2.25rem);
  }

  nav a {
    font-size: var(--t-micro);
    letter-spacing: 0.14em;
    text-transform: uppercase;
    text-decoration: none;
    color: var(--muted);
  }

  nav a:hover,
  nav a[aria-current='page'] {
    color: var(--ink);
  }

  nav a[aria-current='page'] {
    text-decoration: underline;
    text-underline-offset: 5px;
  }

  @media (max-width: 560px) {
    .site-header {
      grid-template-columns: 1fr auto;
    }
    nav {
      grid-column: 1 / -1;
      grid-row: 2;
      justify-content: space-between;
      padding-top: 0.75rem;
      border-top: 1px solid var(--rule);
    }
  }
</style>
