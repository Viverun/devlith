---
import { SITE } from '../site';
const year = new Date().getFullYear();
---

<footer class="site-footer wrap">
  <hr class="rule" />
  <div class="row">
    <span class="label">© {year} {SITE.author}</span>
    <nav class="links" aria-label="Elsewhere">
      <a class="label" href={SITE.links.github}>GitHub</a>
      {SITE.links.email && <a class="label" href={SITE.links.email}>Email</a>}
      <a class="label" href="/rss.xml">RSS</a>
    </nav>
    <span class="label">Set in JetBrains Mono</span>
  </div>
</footer>

<style>
  .site-footer {
    margin-top: clamp(4rem, 10vw, 8rem);
    padding-bottom: 2rem;
  }

  .row {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 1rem;
    padding-top: 1.25rem;
  }

  .links {
    display: flex;
    gap: 1.5rem;
  }

  .links a {
    text-decoration: none;
  }

  .links a:hover {
    color: var(--ink);
  }
</style>
